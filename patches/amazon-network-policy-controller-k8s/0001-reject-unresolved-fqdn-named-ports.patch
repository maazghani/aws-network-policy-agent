+package resolvers
+
+import (
+	"context"
+	"testing"
+
+	policyinfo "github.com/aws/amazon-network-policy-controller-k8s/api/v1alpha1"
+	"github.com/stretchr/testify/require"
+	corev1 "k8s.io/api/core/v1"
+	networking "k8s.io/api/networking/v1"
+	"k8s.io/apimachinery/pkg/util/intstr"
+	"sigs.k8s.io/controller-runtime/pkg/log/zap"
+)
+
+func TestFQDNPortsNeverWidenNamedPorts(t *testing.T) {
+	r := &applicationNetworkPolicyEndpointsResolver{logger: zap.New()}
+	named, numeric := intstr.FromString("https"), intstr.FromInt(443)
+	end := int32(445)
+	udp := corev1.ProtocolUDP
+	for _, tt := range []struct {
+		name   string
+		ports  []networking.NetworkPolicyPort
+		want   []policyinfo.Port
+		denied bool
+	}{
+		{name: "named only", ports: []networking.NetworkPolicyPort{{Port: &named}}, denied: true},
+		{name: "mixed named and numeric", ports: []networking.NetworkPolicyPort{{Port: &named}, {Port: &numeric}}, want: []policyinfo.Port{{Port: int32Ptr(443)}}},
+		{name: "range", ports: []networking.NetworkPolicyPort{{Port: &numeric, EndPort: &end}}, want: []policyinfo.Port{{Port: int32Ptr(443), EndPort: &end}}},
+		{name: "omitted list"},
+		{name: "omitted port", ports: []networking.NetworkPolicyPort{{Protocol: &udp}}, want: []policyinfo.Port{{Protocol: &udp}}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			got := r.resolveFQDNRules([]policyinfo.DomainName{"example.com"}, tt.ports)
+			if tt.denied {
+				require.Empty(t, got)
+				return
+			}
+			require.Len(t, got, 1)
+			require.Len(t, got[0].Ports, len(tt.want))
+			for i, want := range tt.want {
+				require.Equal(t, want.Port, got[0].Ports[i].Port)
+				require.Equal(t, want.EndPort, got[0].Ports[i].EndPort)
+				protocol := corev1.ProtocolTCP
+				if want.Protocol != nil {
+					protocol = *want.Protocol
+				}
+				require.Equal(t, protocol, *got[0].Ports[i].Protocol)
+			}
+		})
+	}
+}
+
+func TestFQDNNamedPortRejectionRetainsEgressIsolation(t *testing.T) {
+	r := &applicationNetworkPolicyEndpointsResolver{logger: zap.New()}
+	named := intstr.FromString("https")
+	policy := &policyinfo.ApplicationNetworkPolicy{Spec: policyinfo.ApplicationNetworkPolicySpec{
+		PolicyTypes: []networking.PolicyType{networking.PolicyTypeEgress},
+		Egress: []policyinfo.ApplicationNetworkPolicyEgressRule{{
+			Ports: []networking.NetworkPolicyPort{{Port: &named}},
+			To:    []policyinfo.ApplicationNetworkPolicyPeer{{DomainNames: []policyinfo.DomainName{"example.com"}}},
+		}},
+	}}
+	endpoints, err := r.computeApplicationNetworkPolicyEgressEndpoints(context.Background(), policy)
+	require.NoError(t, err)
+	require.Empty(t, endpoints)
+	require.Equal(t, []networking.PolicyType{networking.PolicyTypeEgress}, policy.Spec.PolicyTypes)
+	require.Equal(t, policy.Spec.PolicyTypes, r.convertApplicationNetworkPolicyToNetworkPolicyWithNoEgress(policy).Spec.PolicyTypes)
+}
